# Player profile / lifetime scoring data -- generated at runtime, grows with
# play, and is personal to whoever's machine is running the engine. Treated
# like local state, not source, the same way games/ (your authored puzzles)
# is committed but this isn't.
players.json

# Active multiplayer crash-recovery snapshot -- runtime state only.
active-rooms.json
active-rooms.json.tmp-*

# Generated on every npm start so the live checkout can be fingerprinted
# without creating a dirty Git worktree merely by running the server.
DEPLOY_MANIFEST.json

players.json.bak
players.json.corrupt-*
players.json.tmp-*

# Authentication database -- contains password hashes and player emails.
auth-store.json
auth-store.json.tmp
.gm-password
gm-lockouts.json
